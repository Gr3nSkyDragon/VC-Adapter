# The VC-Adapter board profile, on top of sdkconfig.defaults (the GB-Link profile): the console's link port is wired to this board
# through a level shifter, with no GB-Link. package-release-bin.ps1 -Board vcadapter builds it; by hand:
#   idf.py -B build-vcadapter -D SDKCONFIG=build-vcadapter/sdkconfig -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.vcadapter" build
# The pins are the shared VC-Adapter / GB-Link pinout (Kconfig's defaults): SC D0, SI D1, SO D2, SD D3 on a XIAO ESP32-S3.
CONFIG_UDS_LINK_PORT=y
# CONFIG_UDS_PICO_LINK is not set
