# The Flipper board runs the 3DS radio over native USB CDC.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_DESC_PRODUCT_STRING="VC-Adapter ESP32-S2 UDS"
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4001
# Use slave mode to avoid ESP32-S2 USB-105 DMA corruption on rev 0.0.
CONFIG_TINYUSB_MODE_SLAVE=y
