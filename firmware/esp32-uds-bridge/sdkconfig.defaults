# Shared by every chip. ESP-IDF reads sdkconfig.defaults.<chip> after this file: the CPU clock, the console, the GB-Link Pico's
# UART pins and the memory each chip can spare are set there. The target itself comes from IDF_TARGET (CMakeLists.txt).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_FREERTOS_HZ=1000
# Nothing is logged, so in 3DS mode the host port carries only the binary protocol.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# Messages up to INFO are compiled in, but the default level stays NONE: only the 3DS side raises it, and sends the log to the host
# as LOG frames (main/diag.c). GB-Link Switch LDN's mode keeps its console free of them.
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# Wi-Fi buffers: ESP-IDF's defaults on the S3 and the C6, as GB-Link Switch LDN's side is built with there (the classic ESP32 and the
# C3 trim them in their own files, as upstream does). The 3DS side asks for its own numbers, and no aggregation, when it starts Wi-Fi
# (radio.c, init_wifi_once; main/Kconfig.projbuild's UDS_WIFI_*, whose defaults are per chip).
# A 3 MB app slot for both sides (partitions.csv); NVS stays at 0x9000.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The Game Boy wrapper decrypts every frame in software (AES-CCM): build for speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# GB-Link Switch LDN's side (as its own sdkconfig.defaults): it runs on the main task, and hosting a room starts an access
# point with static DHCP entries.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
