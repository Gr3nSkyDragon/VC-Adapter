# Firmware 2.0-aio (was 1.9, profile 2, "vcadapter"): the standalone VC-Adapter board for the GB/GBA games (the GBA side since 2.1), on top of
# sdkconfig.defaults. The console's link port is wired to this board through a level shifter, with no GB-Link and no PC.
# package-release-bin.ps1 -Line aio builds it; by hand:
#   idf.py -B build-aio-esp32s3 -D IDF_TARGET=esp32s3 -D SDKCONFIG=build-aio-esp32s3/sdkconfig -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.aio" build
# ESP32-S3 only: the board is S3 hardware, and its default pins clash on the other chips (UART0 on the classic ESP32's GPIO1 and 3,
# the XIAO C6's RF switch on GPIO3). main/Kconfig.projbuild makes UDS_LINK_PORT depend on the S3.
# The pins are the shared VC-Adapter / GB-Link pinout (Kconfig's defaults): SC D0, SI D1, SO D2, SD D3 on a XIAO ESP32-S3.
CONFIG_UDS_LINK_PORT=y
# The Switch side, with the GBA Wireless Adapter emulated on the link port in place of a GB-Link (CONFIG_UDS_RFU_ADAPTER, on by
# default with both). Its link task keeps the second core with interrupts masked while the adapter is on, so the interrupt
# watchdog must not check that core, and the task watchdog not wait for its idle task.
CONFIG_UDS_SWITCH_LDN=y
# The console sense divider on pin 1 (R1, R2) goes to the XIAO's MTCK pad.
CONFIG_UDS_LINK_PORT_SENSE_GPIO=39
# CONFIG_ESP_INT_WDT_CHECK_CPU1 is not set
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
# The XIAO ESP32-S3's 8 MB of octal PSRAM (an ESP32-S3R8), for the Wi-Fi and network stacks' buffers: the emulated adapter keeps
# ~29 KB of internal RAM the GB-Link profile has free, and hosting a room for the Switch (the GBA leading) ran the free heap down
# to ~11 KB. With this the lowest seen is 8 MB. The adapter's link code and data stay in internal RAM. A board without PSRAM
# still boots (as before).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# GB-Link Switch LDN 2.2's memory settings for an ESP32-S3 hosting with the adapter on the board (their 60ff8cb): a 1 KB zstd
# literal buffer (Pia's bodies fit it; the context drops from 40 KB to 33 KB of internal RAM) and a 16 KB Switch-side USB receive
# buffer instead of 32 KB (a board on the link port seldom has a PC sending much in Switch mode).
CONFIG_PIA_ZSTD_LITERAL_BUFFER=1024
CONFIG_BRIDGE_USB_RX_BUFFER=16384
