# ESP32-C3 (alpha: builds, not yet run on hardware). Settings from GB-Link Switch LDN's firmware/ESP32-C3 (upstream).
# One core; 160 MHz is the chip's top clock.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# The GB-Link Pico's UART: GPIO5 to its GP9, GPIO4 to its GP8 (GPIO2, 8 and 9 are C3 strapping pins).
CONFIG_PICO_LINK_TX_GPIO=5
CONFIG_PICO_LINK_RX_GPIO=4
# The C3 has the least RAM of the four chips, and its code RAM and data RAM are the same memory: Wi-Fi's receive and hot-path code
# runs from flash instead, the Wi-Fi buffers are trimmed as on the classic ESP32 (Switch networks are 802.11b/g, no aggregation),
# and the Switch side's USB console buffers are cut to 8 KB and 4 KB. The 3DS side's own numbers: main/Kconfig.projbuild.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LWIP_IPV6=n
CONFIG_BRIDGE_USB_RX_BUFFER=8192
CONFIG_BRIDGE_USB_TX_BUFFER=4096
# 8.5 dBm: some C3 boards (the C3 SuperMini among them) garble their frames at full power. Upstream caps the Switch side; this
# firmware's 3DS side uses the same cap (radio.c).
CONFIG_BRIDGE_WIFI_MAX_TX_POWER=34
